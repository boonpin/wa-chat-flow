# WA Chat Flow — all-in-one deployment.
#
# One file for both services. WAHA_API_KEY is shared between them from here,
# which is the whole point of this layout: there is no second .env to drift.
#
# Generate every secret below with:  openssl rand -hex 32

# ─── Image ────────────────────────────────────────────────────────────────────
# The app image, built and pushed by ../../docker-build.mjs. Pin the tag to a
# build number (the script's BUILD_NUMBER, e.g. 2609161214) for a deployment you
# can roll back to; `latest` moves under you.
#
# Running an image built locally but never pushed? APP_IMAGE=wa-chat-flow with
# APP_IMAGE_TAG=local is the script's LOCAL_TAG — no registry involved.
APP_IMAGE=ghcr.io/boonpin/wa-chat-flow
APP_IMAGE_TAG=latest

# ─── App ──────────────────────────────────────────────────────────────────────
# Public URL people open in a browser. Used for links, not for reaching WAHA —
# the two containers talk over the compose network by service name.
APP_URL=http://localhost:3000

# Host interface and port the app is published on. Put a reverse proxy in front
# of it for TLS and set APP_BIND=127.0.0.1 so nothing but the proxy can reach it.
APP_BIND=0.0.0.0
APP_PORT=3000

# REQUIRED. Signs the session cookie. Changing it logs everyone out.
JWT_SECRET=

# Bootstrap admin account, created on first start only. Changing ADMIN_PASSWORD
# later does NOT rotate it — run `pnpm seed` for that. Leave ADMIN_PASSWORD
# empty to skip creation entirely.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─── WAHA (WhatsApp gateway) ──────────────────────────────────────────────────
# REQUIRED. Protects WAHA's REST API. Read by both services from this one line,
# so they cannot disagree about it.
WAHA_API_KEY=

# Signs webhook deliveries (HMAC sha512). The webhook route is public — this
# signature is the only thing between the internet and the message handler, so
# an empty value turns that check OFF. Always set it.
WAHA_WEBHOOK_HMAC_KEY=

# REQUIRED. Login for WAHA's web dashboard (browser basic auth). Completely
# unrelated to WAHA_API_KEY above; logging in here grants no API access.
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=

# ─── AI provider fallbacks ────────────────────────────────────────────────────
# Optional. Used only by an AI provider row that has no key of its own.
OPENAI_API_KEY=
GEMINI_API_KEY=
