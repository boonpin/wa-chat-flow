# ─── App ──────────────────────────────────────────────────────────────────────
# Public base URL of WA Chat Flow. WAHA calls back to this for webhooks, so it
# must be reachable from the WAHA container (inside Docker: http://app:3000).
APP_URL=http://localhost:3000

# ─── Auth ─────────────────────────────────────────────────────────────────────
# REQUIRED in production. Generate with: openssl rand -hex 32
JWT_SECRET=

# Bootstrap admin account. The user is created on first start only; changing
# ADMIN_PASSWORD later does NOT rotate it (use `pnpm seed` for that).
# If ADMIN_PASSWORD is empty, no admin is created and you must run `pnpm seed`.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─── WAHA (WhatsApp HTTP API) ─────────────────────────────────────────────────
# Inside Docker Compose this is the internal service name; WAHA is never
# exposed publicly.
WAHA_BASE_URL=http://waha:3000
# Must match WAHA's WHATSAPP_API_KEY.
WAHA_API_KEY=
# Shared HMAC key used to sign webhook deliveries (sha512). Generate with:
# openssl rand -hex 32
WAHA_WEBHOOK_HMAC_KEY=

